# Dynamic Pricing Engine - Environment Variables
# Copy this file to .env and update values as needed

# Database (SQLite - no Docker needed)
DATABASE_URL=sqlite+aiosqlite:///./dpe.db
DATABASE_URL_SYNC=sqlite:///./dpe.db

# Security (CHANGE THIS IN PRODUCTION!)
SECRET_KEY=your-secret-key-change-in-production-min-32-characters-long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ML Models
MODELS_DIR=../amazon_price_model/artifacts

# API Settings
DEBUG=True
PROJECT_NAME=Dynamic Pricing Engine

# CORS Origins (for frontend)
CORS_ORIGINS=["http://localhost:3000", "http://localhost:3001"]
